{
  "name": "formula-modeler-1",
  "version": "1.0.0",
  "description": "A simple CAP project.",
  "repository": "<Add your repository here>",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@cap-js/hana": "^1",
    "@sap/cds": "^8",
    "@sap/xssec": "^4",
    "@sapui5/generator-sapui5-templates": "^1.71.1",
    "express": "^4",
    "mathjs": "^14.4.0"
  },
  "devDependencies": {
    "@cap-js/cds-types": "^0.9.0",
    "@cap-js/sqlite": "^1",
    "@sap/cds-dk": "^8",
    "mbt": "^1.2.29",
    "rimraf": "^5.0.5"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-manager": "cds watch --open manager/webapp/index.html?sap-ui-xx-viewCache=false",
    "undeploy": "cf undeploy formula-modeler-1 --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1"
  },
  "cds": {
    "sql": {
      "native_hana_associations": false
    },
    "requires": {
      "[production]": {
        "db": "hana"
      },
      "[hybrid]": {
        "db": "hana"
      },
      "auth": "xsuaa"
    }
  }
}
