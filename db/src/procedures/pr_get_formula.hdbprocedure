PROCEDURE "pr_get_formula" ( in p_formula_id nvarchar(36), out p_formula nvarchar(2048 ))
   LANGUAGE GRAPH
   --DEFAULT SCHEMA <default_schema_name>
   READS SQL DATA 
   AS
BEGIN
   /*************************************
   * Build and retrieve the formula
   * Input: p_formula_id from the formula entity
   * Output: p_formula as a string
   *************************************/
   graph g = Graph("G_WS_FORMULAE")
             with temporary attributes(vertex nvarchar temp_formula_part);
   nvarchar(4096) formula_part = '';
   nvarchar(255)  lnode_part = '';
   nvarchar(255)  rnode_part = '';
   nvarchar(36)   root_node_id = '';	
   
   --Get the root node from the formula ID
   foreach   v in Vertices(:g){
	   if (:v.node_is_root == true and :v.formula_id == :p_formula_id){root_node_id = :v.id;}
   }

   -- Get the root node for graph traversal
   vertex root_node = Vertex(:g, :root_node_id);

   -- Copy the node_operand to the temporary attributes
   -- This allows us to pass on part-formula up the tree
   foreach   v in Vertices(:g){
   	v.temp_formula_part = :v.node_operand;
   }
   
   -- Traverse the graph with DFS algorithm
   -- ( Start with the inner most formula and build outwards)
   traverse dfs :g from :root_node
   on exit vertex(vertex v){

      if ( :v."NODE_IS_ROOT" == false and :v."NODE_IS_LEAF" == false ){
         -- Look at the left-branch
         Multiset<Edge> o_ledge = e in out_edges(:v) where  :e.edge_location == 'l';
         foreach e in  :o_ledge {
            Vertex o_lnode  = TARGET(:e);
            lnode_part = :o_lnode.temp_formula_part;
         } 
         -- Look at the right-branch
         Multiset<Edge> o_redge = e in out_edges(:v) where  :e.edge_location == 'r';
         foreach e in  :o_redge {
               Vertex o_rnode  = TARGET(:e);
               rnode_part = :o_rnode.temp_formula_part;
         }
         -- Concatenate the left and right branches and save into temporary attribute
         v.temp_formula_part =  '('||:lnode_part||:v.node_operator||:rnode_part||')';

         formula_part = :v.temp_formula_part;
      }
      
   };

   p_formula = :formula_part;
   
END